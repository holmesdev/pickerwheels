{
  "_id": "pickerwheels@0.1.0",
  "name": "pickerwheels",
  "version": "0.1.1",
  "private": true,
  "packageManager": "yarn@4.9.1",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "lint:fix": "next lint --fix",
    "type-check": "tsc --noEmit",
    "format": "prettier --check \"**/*.{js,jsx,ts,tsx,json,md}\"",
    "format:fix": "prettier --write \"**/*.{js,jsx,ts,tsx,json,md}\"",
    "ci": "yarn lint && yarn type-check && yarn format && yarn build",
    "fix": "yarn lint:fix && yarn type-check && yarn format:fix",
    "test": "jest",
    "e2e": "playwright test",
    "chromatic": "chromatic --exit-once-uploaded",
    "db:types": "line_number=$(sed -n '/upsert_wheel/=' src/db/types.ts) && supabase gen types typescript --local | sed \"$(expr $line_number + 2)s/string/string | null/\" > src/db/types.ts",
    "db:create-migration": "supabase migration new",
    "db:migrate": "supabase db reset"
  },
  "dependencies": {
    "@emotion/cache": "^11.14.0",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.0",
    "@mui/icons-material": "^7.1.0",
    "@mui/material": "7.1.0",
    "@mui/material-nextjs": "^7.1.0",
    "@supabase/ssr": "^0.6.1",
    "@supabase/supabase-js": "^2.49.4",
    "@tailwindcss/postcss": "^4.1.6",
    "@vercel/analytics": "^1.5.0",
    "@vercel/speed-insights": "^1.2.0",
    "encoding": "^0.1.13",
    "next": "15.3.2",
    "notistack": "^3.0.2",
    "postcss": "^8.4.35",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "styled-jsx": "5.1.7",
    "tailwindcss": "^4.1.6",
    "typescript": "5.8.3"
  },
  "devDependencies": {
    "@next/bundle-analyzer": "15.3.2",
    "@playwright/test": "1.52.0",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/jest": "^29.5.14",
    "@types/node": "22.15.17",
    "@types/react": "19.1.3",
    "@types/react-dom": "19.1.3",
    "eslint": "9.26.0",
    "eslint-config-next": "15.3.2",
    "eslint-plugin-storybook": "^0.12.0",
    "jest": "^29.7.0",
    "jest-canvas-mock": "^2.5.2",
    "jest-environment-jsdom": "^29.7.0",
    "jest-junit": "^16.0.0",
    "prettier": "^3.5.3"
  }
}
